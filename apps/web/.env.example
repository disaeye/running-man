# Server-side backend URL for next.config.js rewrites.
# Private: NOT exposed to the browser. Both values point at the FastAPI port
# on this host; the frontend and API are reached through one origin, so the
# HttpOnly auth cookie stays same-origin and no CORS handling is needed.
API_URL=http://127.0.0.1:31001
# Legacy fallback used only when API_URL is unset; prefer API_URL above.
NEXT_PUBLIC_API_URL=http://127.0.0.1:31001
