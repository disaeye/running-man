DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_CLIENT_ID=
INTERVALS_ICU_CLIENT_SECRET=
INTERVALS_ICU_WEBHOOK_SECRET=
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256

# Optional outbound HTTP proxy support. httpx honors these automatically.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Optional Intervals.icu client rate limiting for shared proxy paths.
INTERVALS_RATE_LIMIT_REFILL_RATE=5.0
INTERVALS_RATE_LIMIT_CAPACITY=10
