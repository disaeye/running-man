[Unit]
Description=Running Man scheduled activity sync
After=running-man-api.service

[Service]
Type=oneshot
WorkingDirectory=%h/workspace/code/running-man/apps/api
EnvironmentFile=%h/workspace/code/running-man/apps/api/.env
# Absolute venv path rather than `uv`: systemd's user PATH does not include
# ~/.local/bin, which is why the stale-audit unit had been failing nightly.
ExecStart=%h/workspace/code/running-man/apps/api/.venv/bin/python -m application.integrations.scheduler
TimeoutStartSec=1800
