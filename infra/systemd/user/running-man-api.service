[Unit]
Description=Running Man API (FastAPI, port 31001)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/code/running-man/apps/api
EnvironmentFile=%h/workspace/code/running-man/apps/api/.env
# Absolute venv path rather than `uv`: systemd's user PATH does not include
# ~/.local/bin, which is why the stale-audit unit had been failing nightly.
ExecStart=%h/workspace/code/running-man/apps/api/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 31001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
